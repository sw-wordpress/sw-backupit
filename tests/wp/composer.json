{
    "name": "swbackupit/wp-tests",
    "description": "WordPress integration test environment (isolated from the main dev dependencies: WP test suite needs PHPUnit 9.6).",
    "type": "project",
    "require-dev": {
        "johnpbloch/wordpress-core": "^6.8",
        "phpunit/phpunit": "^9.6",
        "wp-phpunit/wp-phpunit": "^6.8",
        "yoast/phpunit-polyfills": "^2.0"
    },
    "config": {
        "platform": {
            "php": "8.2.0"
        },
        "allow-plugins": {
            "johnpbloch/wordpress-core-installer": true
        }
    },
    "extra": {
        "wordpress-install-dir": "vendor/wordpress"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../..",
            "options": {
                "symlink": true
            }
        }
    ],
    "require": {
        "swbackupit/swbackupit": "*@dev"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}