<?xml version="1.0" encoding="UTF-8"?>
<phpunit bootstrap="bootstrap.php" colors="true" backupGlobals="false" convertErrorsToExceptions="true" convertWarningsToExceptions="true" convertNoticesToExceptions="true" convertDeprecationsToExceptions="false">
    <testsuites>
        <testsuite name="wordpress">
            <directory suffix="Test.php">tests</directory>
        </testsuite>
    </testsuites>
    <php>
        <const name="WP_RUN_CORE_TESTS" value="0"/>
    </php>
    <coverage>
        <include>
            <directory suffix=".php">../../packages/wordpress/src</directory>
            <file>../../sw-backupit.php</file>
            <file>../../uninstall.php</file>
        </include>
    </coverage>
</phpunit>
