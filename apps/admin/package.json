{
  "name": "sw-backupit-admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "sw-backupit WordPress admin frontend (Vue 3 + Quasar, no Quasar CLI)",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:only": "vite build",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage && node scripts/check-coverage.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "test:updates-ui": "node scripts/test-updates-ui.mjs"
  },
  "dependencies": {
    "@quasar/extras": "^2.1.0",
    "pinia": "^4.1.0",
    "quasar": "^2.35.5",
    "vue": "^3.5.46",
    "vue-i18n": "^11.4.23",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.2.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@quasar/vite-plugin": "^2.0.2",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/coverage-v8": "^5.1.1",
    "@vue/test-utils": "^2.6.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "playwright-core": "1.65.1",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.0.5",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^3.3.14"
  },
  "overrides": {
    "minimatch@>=7 <11.0.1": "^11.0.5",
    "glob": "^14.0.4"
  }
}