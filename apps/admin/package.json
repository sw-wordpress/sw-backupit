{
  "name": "sw-backupit-admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "sw-backupit WordPress admin frontend (Vue 3 + Quasar, no Quasar CLI)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:only": "vite build",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage && node scripts/check-coverage.mjs",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@quasar/extras": "^1.17.0",
    "pinia": "^3.0.0",
    "quasar": "^2.18.0",
    "vue": "^3.5.0",
    "vue-i18n": "^11.4.17",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.2.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@quasar/vite-plugin": "1.9.0",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitest/coverage-v8": "^3.2.4",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "playwright-core": "1.64.1",
    "postcss": "^8.5.32",
    "prettier": "^3.5.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.3.0",
    "vitest": "^3.2.0",
    "vue-eslint-parser": "^10.0.0",
    "vue-tsc": "^3.3.14"
  }
}
