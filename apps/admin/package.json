{
  "name": "sw-backupit-admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "sw-backupit WordPress admin frontend (Vue 3 + Quasar, no Quasar CLI)",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:only": "vite build",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage && node scripts/check-coverage.mjs",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@quasar/extras": "^2.1.0",
    "pinia": "^4.1.0",
    "quasar": "^2.35.2",
    "vue": "^3.5.0",
    "vue-i18n": "^11.4.17",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.2.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@quasar/vite-plugin": "^2.0.2",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.1.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^16.0.0",
    "jsdom": "^24.1.3",
    "playwright-core": "1.55.1",
    "postcss": "^8.5.0",
    "prettier": "^3.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.0.5",
    "vue-eslint-parser": "^10.0.0",
    "vue-tsc": "^3.0.0"
  }
}
