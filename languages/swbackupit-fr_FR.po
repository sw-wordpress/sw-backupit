msgstr "Destinataire de notification invalide."

#. translators: 1: required PHP version, 2: current PHP version
#: swbackupit.php:35
#, php-format
msgid "SWBackupIt requires PHP %1$s or newer. You are running PHP %2$s."
msgstr "SWBackupIt nécessite PHP %1$s ou une version plus récente. Vous utilisez PHP %2$s."

#: swbackupit.php:54
msgid "SWBackupIt: the vendor directory is missing. Install the release package or run \"composer install\"."
msgstr "SWBackupIt : le répertoire vendor est manquant. Installez le paquet de la version publiée ou exécutez « composer install »."
