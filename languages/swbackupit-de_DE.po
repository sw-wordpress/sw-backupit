#: packages/wordpress/src/Support/CoreMessages.php:172
msgid "The backup exceeds the configured restore size limit."
msgstr "Das Backup überschreitet das konfigurierte Größenlimit für die Wiederherstellung."

#: packages/wordpress/src/Support/CoreMessages.php:173
msgid "The backup was not found in the configured backups directory."
msgstr "Das Backup wurde im konfigurierten Backup-Verzeichnis nicht gefunden."

#: packages/wordpress/src/Support/CoreMessages.php:174
msgid "The backups directory does not exist."
msgstr "Das Backup-Verzeichnis existiert nicht."

#: packages/wordpress/src/Support/CoreMessages.php:175
msgid "The base backup is encrypted but no key store is available."
msgstr "Das Basis-Backup ist verschlüsselt, aber es ist kein Schlüsselspeicher verfügbar."

#: packages/wordpress/src/Support/CoreMessages.php:176
msgid "The bucket name is invalid."
msgstr "Der Bucket-Name ist ungültig."

#: packages/wordpress/src/Support/CoreMessages.php:177
msgid "The encrypted file failed the decryption round trip."
msgstr "Die verschlüsselte Datei hat den Entschlüsselungs-Rundlauftest nicht bestanden."

#: packages/wordpress/src/Support/CoreMessages.php:178
msgid "The encrypted file is corrupt (invalid chunk length)."
msgstr "Die verschlüsselte Datei ist beschädigt (ungültige Chunk-Länge)."

#: packages/wordpress/src/Support/CoreMessages.php:179
msgid "The encrypted file is truncated."
msgstr "Die verschlüsselte Datei ist abgeschnitten."

#: packages/wordpress/src/Support/CoreMessages.php:180
msgid "The endpoint URL is invalid."
msgstr "Die Endpunkt-URL ist ungültig."

#: packages/wordpress/src/Support/CoreMessages.php:181
msgid "The endpoint must use http or https."
msgstr "Der Endpunkt muss http oder https verwenden."

#: packages/wordpress/src/Support/CoreMessages.php:182
msgid "The endpoint points to a private or reserved network address."
msgstr "Der Endpunkt verweist auf eine private oder reservierte Netzwerkadresse."

#: packages/wordpress/src/Support/CoreMessages.php:183
msgid "The file changed while it was being uploaded."
msgstr "Die Datei hat sich während des Uploads geändert."

#: packages/wordpress/src/Support/CoreMessages.php:184
msgid "The file index references an invalid backup id."
msgstr "Der Dateiindex verweist auf eine ungültige Backup-ID."

#: packages/wordpress/src/Support/CoreMessages.php:185
msgid "The file was encrypted with a raw key but a passphrase was supplied."
msgstr "Die Datei wurde mit einem Rohschlüssel verschlüsselt, es wurde jedoch eine Passphrase angegeben."

#: packages/wordpress/src/Support/CoreMessages.php:186
msgid "The host name could not be resolved."
msgstr "Der Hostname konnte nicht aufgelöst werden."

#: packages/wordpress/src/Support/CoreMessages.php:187
msgid "The host name is invalid."
msgstr "Der Hostname ist ungültig."

#: packages/wordpress/src/Support/CoreMessages.php:188
msgid "The job lease was lost to another worker."
msgstr "Die Sperre des Jobs ist an einen anderen Worker übergegangen."

#: packages/wordpress/src/Support/CoreMessages.php:189
msgid "The key derivation parameters are out of the accepted range."
msgstr "Die Parameter der Schlüsselableitung liegen außerhalb des zulässigen Bereichs."

#: packages/wordpress/src/Support/CoreMessages.php:190
msgid "The key id must be 1-64 characters of A-Z a-z 0-9 . _ -"
msgstr "Die Schlüssel-ID muss aus 1-64 Zeichen der Menge A-Z a-z 0-9 . _ - bestehen."

#: packages/wordpress/src/Support/CoreMessages.php:191
msgid "The local file changed while it was being uploaded."
msgstr "Die lokale Datei hat sich während des Uploads geändert."

#: packages/wordpress/src/Support/CoreMessages.php:192
msgid "The local file to upload does not exist."
msgstr "Die hochzuladende lokale Datei existiert nicht."

#: packages/wordpress/src/Support/CoreMessages.php:193
msgid "The local storage directory cannot be created."
msgstr "Das lokale Speicherverzeichnis kann nicht erstellt werden."

#: packages/wordpress/src/Support/CoreMessages.php:194
msgid "The passphrase must be at least 8 characters long."
msgstr "Die Passphrase muss mindestens 8 Zeichen lang sein."

#: packages/wordpress/src/Support/CoreMessages.php:195
msgid "The port is invalid."
msgstr "Der Port ist ungültig."

#: packages/wordpress/src/Support/CoreMessages.php:196
msgid "The restore application directory does not exist."
msgstr "Das Verzeichnis der Restore-Anwendung existiert nicht."

#: packages/wordpress/src/Support/CoreMessages.php:197
msgid "The restore has not completed successfully; the application stays available."
msgstr "Die Wiederherstellung wurde nicht erfolgreich abgeschlossen; die Anwendung bleibt verfügbar."

#: packages/wordpress/src/Support/CoreMessages.php:198
msgid "The restore target and the backup directory must not contain each other."
msgstr "Wiederherstellungsziel und Backup-Verzeichnis dürfen einander nicht enthalten."

#: packages/wordpress/src/Support/CoreMessages.php:199
msgid "The restore target directory does not exist."
msgstr "Das Zielverzeichnis der Wiederherstellung existiert nicht."

#: packages/wordpress/src/Support/CoreMessages.php:200
msgid "The scratch database could not be created (missing privilege)."
msgstr "Die temporäre Datenbank konnte nicht erstellt werden (fehlende Berechtigung)."

#: packages/wordpress/src/Support/CoreMessages.php:201
msgid "The selected tables are not part of the backup."
msgstr "Die ausgewählten Tabellen sind nicht Teil des Backups."

#: packages/wordpress/src/Support/CoreMessages.php:202
msgid "The staging directory is not writable."
msgstr "Das Staging-Verzeichnis ist nicht beschreibbar."

#: packages/wordpress/src/Support/CoreMessages.php:203
msgid "The storage target does not exist."
msgstr "Das Speicherziel existiert nicht."

#: packages/wordpress/src/Support/CoreMessages.php:204
msgid "The target database name was not confirmed correctly."
msgstr "Der Name der Zieldatenbank wurde nicht korrekt bestätigt."

#: packages/wordpress/src/Support/CoreMessages.php:205
msgid "The target directory must be an existing absolute path."
msgstr "Das Zielverzeichnis muss ein vorhandener absoluter Pfad sein."

#: packages/wordpress/src/Support/CoreMessages.php:206
msgid "The target is outside the permitted restore locations."
msgstr "Das Ziel liegt außerhalb der zulässigen Wiederherstellungsorte."

#: packages/wordpress/src/Support/CoreMessages.php:207
msgid "The token lifetime must be between 1 minute and 7 days."
msgstr "Die Gültigkeitsdauer des Tokens muss zwischen 1 Minute und 7 Tagen liegen."

#: packages/wordpress/src/Support/CoreMessages.php:208
msgid "These files changed while the backup was running; their restored content may be inconsistent:"
msgstr "Diese Dateien wurden während der Sicherung geändert; ihr wiederhergestellter Inhalt kann inkonsistent sein:"

#: packages/wordpress/src/Support/CoreMessages.php:209
msgid "This backup is encrypted. Provide the encryption key to read its contents."
msgstr "Dieses Backup ist verschlüsselt. Geben Sie den Verschlüsselungsschlüssel an, um den Inhalt zu lesen."

#: packages/wordpress/src/Support/CoreMessages.php:210
msgid "Time budget must be between 1 and 3600 seconds."
msgstr "Das Zeitbudget muss zwischen 1 und 3600 Sekunden liegen."

#: packages/wordpress/src/Support/CoreMessages.php:211
msgid "Type the database name twice to confirm the database restore."
msgstr "Geben Sie den Datenbanknamen zur Bestätigung der Datenbankwiederherstellung zweimal ein."

#: packages/wordpress/src/Support/CoreMessages.php:212
msgid "URL migration needs a valid old and new URL (http:// or https://)."
msgstr "Für die URL-Migration sind eine gültige alte und neue URL erforderlich (http:// oder https://)."

#: packages/wordpress/src/Support/CoreMessages.php:213
msgid "Unencrypted http endpoints require the private network opt-in."
msgstr "Unverschlüsselte http-Endpunkte erfordern die ausdrückliche Freigabe für private Netzwerke."

#: packages/wordpress/src/Support/CoreMessages.php:214
msgid "Unexpected BIT value."
msgstr "Unerwarteter BIT-Wert."

#: packages/wordpress/src/Support/CoreMessages.php:215
msgid "Unexpected data after the end of the encrypted stream."
msgstr "Unerwartete Daten nach dem Ende des verschlüsselten Streams."

#: packages/wordpress/src/Support/CoreMessages.php:216
msgid "Unknown backup type."
msgstr "Unbekannter Backup-Typ."

#: packages/wordpress/src/Support/CoreMessages.php:217
msgid "Unsafe path: absolute path."
msgstr "Unsicherer Pfad: absoluter Pfad."

#: packages/wordpress/src/Support/CoreMessages.php:218
msgid "Unsafe path: control character."
msgstr "Unsicherer Pfad: Steuerzeichen."

#: packages/wordpress/src/Support/CoreMessages.php:219
msgid "Unsafe path: empty or too long."
msgstr "Unsicherer Pfad: leer oder zu lang."

#: packages/wordpress/src/Support/CoreMessages.php:220
msgid "Unsafe path: forbidden character."
msgstr "Unsicherer Pfad: unzulässiges Zeichen."

#: packages/wordpress/src/Support/CoreMessages.php:221
msgid "Unsafe path: traversal or empty segment."
msgstr "Unsicherer Pfad: Traversierung oder leeres Segment."

#: packages/wordpress/src/Support/CoreMessages.php:222
msgid "Unsupported compression method."
msgstr "Nicht unterstützte Kompressionsmethode."

#: packages/wordpress/src/Support/CoreMessages.php:223
msgid "Unsupported encryption format version."
msgstr "Nicht unterstützte Version des Verschlüsselungsformats."

#: packages/wordpress/src/Support/CoreMessages.php:224
msgid "Unsupported encryption parameters."
msgstr "Nicht unterstützte Verschlüsselungsparameter."

#: packages/wordpress/src/Support/CoreMessages.php:225
msgid "Unsupported storage type."
msgstr "Nicht unterstützter Speichertyp."

#: packages/wordpress/src/Support/CoreMessages.php:226
msgid "Unsupported success policy."
msgstr "Nicht unterstützte Erfolgsrichtlinie."

#: packages/wordpress/src/Support/CoreMessages.php:227
msgid "Upload to one or more storage targets failed temporarily and will be retried."
msgstr "Der Upload zu einem oder mehreren Speicherzielen ist vorübergehend fehlgeschlagen und wird wiederholt."

#: packages/wordpress/src/Support/CoreMessages.php:228
msgid "Volume already closed."
msgstr "Das Volume ist bereits geschlossen."

#: packages/wordpress/src/Support/CoreMessages.php:229
msgid "Volume size is too small."
msgstr "Die Volume-Größe ist zu klein."

#: packages/wordpress/src/Support/CoreMessages.php:230
msgid "Writing failed (disk full?)."
msgstr "Schreiben fehlgeschlagen (Datenträger voll?)."

#: packages/wordpress/src/Support/CoreMessages.php:231
msgid "Writing the archive entry failed."
msgstr "Das Schreiben des Archiveintrags ist fehlgeschlagen."

#: packages/wordpress/src/Support/CoreMessages.php:232
msgid "Writing the recovery package failed."
msgstr "Das Schreiben des Recovery-Pakets ist fehlgeschlagen."

#: packages/wordpress/src/Support/CoreMessages.php:233
msgid "Writing to the restore target failed (disk full?)."
msgstr "Das Schreiben in das Wiederherstellungsziel ist fehlgeschlagen (Datenträger voll?)."

#: packages/wordpress/src/Support/CoreMessages.php:234
msgid "siteurl option missing in the restored database."
msgstr "Die Option siteurl fehlt in der wiederhergestellten Datenbank."

#: packages/wordpress/src/Support/CoreMessages.php:235
msgid "wp-config.php was not found in the restore target."
msgstr "wp-config.php wurde im Wiederherstellungsziel nicht gefunden."

#: packages/wordpress/src/Support/CoreMessages.php:236
msgid "wp-config.php was not found in the target; database settings were not updated."
msgstr "wp-config.php wurde im Ziel nicht gefunden; die Datenbankeinstellungen wurden nicht angepasst."

#: packages/wordpress/src/Support/DefaultProfiles.php:46
msgid "Full backup (everything, without cache)"
msgstr "Vollständiges Backup (alles, ohne Cache)"

#: packages/wordpress/src/Support/DefaultProfiles.php:47
msgid "Complete copy of the WordPress directory and the database. Only cache directories are excluded."
msgstr "Vollständige Kopie des WordPress-Verzeichnisses und der Datenbank. Nur Cache-Verzeichnisse sind ausgeschlossen."

#: packages/wordpress/src/Support/DefaultProfiles.php:60
msgid "Content update (uploads, themes, plugins)"
msgstr "Inhalts-Update (Uploads, Themes, Plugins)"

#: packages/wordpress/src/Support/DefaultProfiles.php:61
msgid "Incremental backup of uploads, themes and plugins (plus the database); only changed files are stored."
msgstr "Inkrementelles Backup von Uploads, Themes und Plugins (plus Datenbank); es werden nur geänderte Dateien gespeichert."

#. translators: %s: admin URL
#: packages/wordpress/src/Support/Notifier.php:52
#, php-format
msgid "Details: %s"
msgstr "Details: %s"

#: packages/wordpress/src/Support/Settings.php:106
msgid "The time budget must be between 1 and 3600 seconds."
msgstr "Das Zeitbudget muss zwischen 1 und 3600 Sekunden liegen."

#: packages/wordpress/src/Support/Settings.php:109
msgid "Resource limits are out of range."
msgstr "Die Ressourcenlimits liegen außerhalb des gültigen Bereichs."

#: packages/wordpress/src/Support/Settings.php:112
msgid "Unknown cron mode."
msgstr "Unbekannter Cron-Modus."

#: packages/wordpress/src/Support/Settings.php:118
msgid "Unknown log level."
msgstr "Unbekannte Log-Stufe."

#: packages/wordpress/src/Support/Settings.php:122
msgid "The staging directory must be an absolute path without \"..\"."
msgstr "Das Staging-Verzeichnis muss ein absoluter Pfad ohne \"..\" sein."

#: packages/wordpress/src/Support/Settings.php:125
msgid "The staging directory is inside the web root, where backups could be downloaded by anyone. Choose a directory outside the web root."
msgstr "Das Staging-Verzeichnis liegt im Web-Root, wo Backups von jedem heruntergeladen werden könnten. Wählen Sie ein Verzeichnis außerhalb des Web-Roots."

#: packages/wordpress/src/Support/Settings.php:129
msgid "Invalid notification recipient."
msgstr "Ungültiger Benachrichtigungsempfänger."

#. translators: 1: required PHP version, 2: current PHP version
#: swbackupit.php:35
#, php-format
msgid "SWBackupIt requires PHP %1$s or newer. You are running PHP %2$s."
msgstr "SWBackupIt benötigt PHP %1$s oder neuer. Sie verwenden PHP %2$s."

#: swbackupit.php:54
msgid "SWBackupIt: the vendor directory is missing. Install the release package or run \"composer install\"."
msgstr "SWBackupIt: Das Verzeichnis \"vendor\" fehlt. Installieren Sie das Release-Paket oder führen Sie \"composer install\" aus."

#~ msgid "The staging directory is inside the web root. Make sure the web server denies access or choose a directory outside the web root in the settings."
#~ msgstr "Das Staging-Verzeichnis liegt innerhalb des Web-Roots. Stellen Sie sicher, dass der Webserver den Zugriff verweigert, oder wählen Sie in den Einstellungen ein Verzeichnis außerhalb des Web-Roots."
