<?xml version="1.0"?>
<ruleset name="SWBackupIt WordPress adapter">
    <description>WordPress Coding Standards for the WordPress adapter (CODE-STYLE.md section 3).</description>
    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>
    <arg name="cache" value=".phpcs-wp.cache"/>
    <file>packages/wordpress/src</file>
    <file>swbackupit.php</file>
    <file>uninstall.php</file>

    <config name="minimum_wp_version" value="6.4"/>
    <config name="testVersion" value="8.2-"/>

    <rule ref="WordPress">
        <!-- Documented project decision (CODE-STYLE 3.1): PSR-4 class names/files (PascalCase) in the namespaced adapter. -->
        <exclude name="WordPress.Files.FileName"/>
        <!-- Short array syntax is not used; short ternaries are allowed for brevity. -->
        <exclude name="Universal.Operators.DisallowShortTernary"/>
        <!-- Method names follow WP-CLI/WordPress snake_case; core interface methods (camelCase) are implemented as dictated by the interface. -->
        <exclude name="WordPress.NamingConventions.ValidFunctionName.MethodNameInvalid"/>
        <exclude name="WordPress.NamingConventions.ValidVariableName.VariableNotSnakeCase"/>
        <exclude name="WordPress.NamingConventions.ValidVariableName.PropertyNotSnakeCase"/>
        <exclude name="WordPress.NamingConventions.ValidVariableName.InterpolatedVariableNotSnakeCase"/>
        <exclude name="WordPress.NamingConventions.ValidVariableName.UsedPropertyNotSnakeCase"/>
        <!-- Documented exception (TODO.md "docblocks"): typed signatures carry the contract; docblocks are required for hook
             payloads and public extension points, and are added incrementally for the remaining methods. -->
        <!-- Documented exception: exception messages are plain translated text that is JSON encoded by the REST layer or
             printed by WP-CLI; they are never echoed into HTML. -->
        <exclude name="WordPress.Security.EscapeOutput.ExceptionNotEscaped"/>
        <exclude name="Squiz.Commenting.FunctionComment.Missing"/>
        <exclude name="Squiz.Commenting.FunctionComment.MissingParamTag"/>
        <exclude name="Squiz.Commenting.ClassComment.Missing"/>
        <exclude name="Squiz.Commenting.VariableComment.Missing"/>
        <exclude name="Squiz.Commenting.FunctionComment.MissingParamComment"/>
        <exclude name="Squiz.Commenting.FunctionComment.ParamCommentFullStop"/>
        <exclude name="Generic.Commenting.DocComment.MissingShort"/>
        <exclude name="Squiz.Commenting.FileComment.SpacingAfterOpen"/>
        <exclude name="Universal.NamingConventions.NoReservedKeywordParameterNames"/>
    </rule>
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array"><element value="swbackupit"/></property>
        </properties>
    </rule>
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array"><element value="swbi"/><element value="swbackupit"/><element value="SWBackupIt"/><element value="SWBACKUPIT"/></property>
        </properties>
    </rule>
    <rule ref="PHPCompatibilityWP"/>
    <!-- WP-CLI dictates the (array $args, array $assoc_args) signature of command methods. -->
    <rule ref="Generic.CodeAnalysis.UnusedFunctionParameter.FoundAfterLastUsed">
        <exclude-pattern>packages/wordpress/src/Cli/*</exclude-pattern>
    </rule>
</ruleset>
