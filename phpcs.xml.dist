<?xml version="1.0"?>
<ruleset name="sw-backupit">
    <description>Coding standards: PSR-12 for core/restore/tests, WordPress for the WP adapter (CODE-STYLE.md).</description>
    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>
    <arg name="cache" value=".phpcs.cache"/>
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/assets/admin/*</exclude-pattern>

    <!-- Core, standalone restore, tests: PSR-12 -->
    <file>packages/core/src</file>
    <file>packages/restore/src</file>
    <file>packages/restore/bin</file>
    <file>tests</file>
    <exclude-pattern>*/tests/wp/*</exclude-pattern>
    <rule ref="PSR12"/>
    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="200"/>
            <property name="absoluteLineLimit" value="0"/>
        </properties>
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>

    <!-- Documented exception: PHPCompatibility 9.x does not understand PHP 8.1 enums and reports "$this"/"self" inside
         enum methods as errors. Restricted to the enum-only Domain directory and to exactly these two sniffs. -->
    <rule ref="PHPCompatibility.Variables.ForbiddenThisUseContexts.OutsideObjectContext">
        <exclude-pattern>packages/core/src/Domain/*</exclude-pattern>
    </rule>
    <rule ref="PHPCompatibility.FunctionDeclarations.NewParamTypeDeclarations.SelfOutsideClassScopeFound">
        <exclude-pattern>packages/core/src/Domain/*</exclude-pattern>
    </rule>

    <!-- PHP compatibility for all PHP code -->
    <config name="testVersion" value="8.2-"/>
    <rule ref="PHPCompatibility">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>
</ruleset>
